PUBLIC_URL=http://localhost:18090
CLOUD_LOGIN_URL=http://localhost:58080/login
CONTACT_EMAIL=
LEGAL_NAME=Dori Développement
LEGAL_ADDRESS=1 rue du Développement, 75000 Paris
LEGAL_REGISTRATION=DEV-LOCAL
HOSTING_PROVIDER=
REQUEST_RETENTION_DAYS=90
