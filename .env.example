LEGAL_DEMO=true

# Server-only shared secret with the cloud API; never expose in browser code.
SITE_REQUESTS_SECRET=

# Transactional emails (server-only). Choose disabled or resend.
EMAIL_PROVIDER=disabled
RESEND_API_KEY=
EMAIL_FROM=noreply@dorify.fr
EMAIL_SALES_TO=ijoober@gmail.com

# Node server settings. Docker fixes PORT=8080, HOST=0.0.0.0 and DATA_DIR=/app/data.
PORT=18090
HOST=127.0.0.1
DATA_DIR=./data
